# Camp Power-Up Environment Configuration
# =======================================
# 
# Copy this file to .env and configure for your environment
# NEVER commit .env files to git repositories!

# Application Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
DEBUG=True

# Database Settings
DATABASE_URL=sqlite:///camp_power_up.db
SECURITY_DB_URL=sqlite:///security.db

# Email Configuration (Gmail)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your-camp-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_SENDER_NAME=Camp Power-Up Team

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Security Settings
SESSION_TIMEOUT_HOURS=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_DEFAULT=200 per day, 50 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_EMAIL=10 per minute
RATE_LIMIT_SMS=10 per minute

# Audit & Logging
AUDIT_LOG_ENABLED=True
SECURITY_LOG_LEVEL=INFO
SECURITY_LOG_FILE=security.log

# Encryption
ENCRYPTION_ALGORITHM=Fernet
DATA_ENCRYPTION_ENABLED=True

# Production Settings (set FLASK_ENV=production)
HTTPS_ONLY=True
SECURE_COOKIES=True
CSRF_PROTECTION=True
