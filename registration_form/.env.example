# Camp Power-Up Email Configuration
# Copy this to .env in your production environment and set your email credentials

# Gmail Configuration (recommended)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
CAMP_EMAIL=your_camp_email@gmail.com
CAMP_EMAIL_PASSWORD=your_app_specific_password

# Alternative: Outlook/Hotmail
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587
# CAMP_EMAIL=your_camp_email@outlook.com
# CAMP_EMAIL_PASSWORD=your_password

# Alternative: Yahoo Mail
# SMTP_SERVER=smtp.mail.yahoo.com
# SMTP_PORT=587
# CAMP_EMAIL=your_camp_email@yahoo.com
# CAMP_EMAIL_PASSWORD=your_app_password

# Other SMTP Providers
# SMTP_SERVER=your_smtp_server.com
# SMTP_PORT=587
# CAMP_EMAIL=your_email@domain.com
# CAMP_EMAIL_PASSWORD=your_password

# Instructions for Gmail:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an "App Password" specifically for this application
# 3. Use the app password (not your regular Gmail password) in CAMP_EMAIL_PASSWORD
# 4. Set CAMP_EMAIL to your Gmail address