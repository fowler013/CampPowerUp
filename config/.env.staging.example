# Staging Environment Variables for Railway
# Copy these to your Railway staging environment settings

# === DATABASE CONFIG ===
# Railway will automatically set DATABASE_URL for PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/database

# === EMAIL CONFIG (Test Mode) ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
CAMP_EMAIL=camppowerup2025+staging@gmail.com
CAMP_EMAIL_PASSWORD=your_gmail_app_password_here
SENDER_NAME=Camp Power-Up (STAGING)

# === SECURITY ===
SECRET_KEY=staging_secret_key_different_from_production
FLASK_ENV=staging
DEBUG=true

# === ADMIN CREDENTIALS ===
ADMIN_USERNAME=stagingadmin
ADMIN_PASSWORD=staging_admin_password

# === FEATURE FLAGS ===
USE_TLS=true
ENABLE_EMAIL_NOTIFICATIONS=false

# === RAILWAY SPECIFIC ===
PORT=${PORT}
RAILWAY_ENVIRONMENT=staging