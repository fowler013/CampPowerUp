{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "startCommand": "python registration_form/app.py"
  },
  "environments": {
    "production": {
      "variables": {
        "FLASK_ENV": "production",
        "DEBUG": "false"
      }
    },
    "staging": {
      "variables": {
        "FLASK_ENV": "staging",
        "DEBUG": "true"
      }
    }
  }
}