# Production Environment Variables for Railway
# Copy these to your Railway environment settings

# === DATABASE CONFIG ===
# Railway will automatically set DATABASE_URL for PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/database

# === EMAIL CONFIG ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
CAMP_EMAIL=camppowerup2025@gmail.com
CAMP_EMAIL_PASSWORD=your_gmail_app_password_here
SENDER_NAME=Camp Power-Up

# === SECURITY ===
SECRET_KEY=your_super_secret_production_key_here_minimum_32_chars
FLASK_ENV=production
DEBUG=false

# === ADMIN CREDENTIALS ===
ADMIN_USERNAME=campadmin
ADMIN_PASSWORD=your_secure_admin_password_here

# === FEATURE FLAGS ===
USE_TLS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# === RAILWAY SPECIFIC ===
PORT=${PORT}
RAILWAY_ENVIRONMENT=production