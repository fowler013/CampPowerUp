# Camp Power-Up Security .gitignore
# ==================================
# IMPORTANT: This project handles camper PII - be strict about what gets committed

# ===========================================
# ENVIRONMENT FILES - NEVER COMMIT
# ===========================================
.env
.env.*
!.env.example
!.env.template
*.env
sendgrid.env

# ===========================================
# SECURITY CREDENTIALS - NEVER COMMIT
# ===========================================
INITIAL_ADMIN_CREDENTIALS.txt
*.key
*.pem
*.crt
*.p12
security_key.key
credentials*.json
secrets*.json

# ===========================================
# DATABASE FILES - CONTAIN PII, NEVER COMMIT
# ===========================================
*.db
*.sqlite
*.sqlite3
camp_power_up.db
camper_data.db
registration_submissions.db

# ===========================================
# CAMPER DATA FILES - PII, NEVER COMMIT
# ===========================================
# CSV files with camper information
data/*.csv
data/*.xlsx
data/*.xls
*.csv

# Backup files with registration data
registration_form/backups/
registration_form/registrations_backup*.json
registrations*.json
*_backup*.json

# Audit logs may contain sensitive info
registration_form/audit_logs/
audit_log*.json

# ===========================================
# PYTHON
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===========================================
# VIRTUAL ENVIRONMENT
# ===========================================
.venv/
venv/
ENV/
env/

# ===========================================
# IDE & OS
# ===========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===========================================
# LOGS
# ===========================================
*.log
logs/

# ===========================================
# ALLOWED CONFIG TEMPLATES (no secrets)
# ===========================================
!config/.env.example
!config/.env.template
!config/.env.production.example
!config/.env.staging.example
!registration_form/.env.example
