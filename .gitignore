# Camp Power-Up Security .gitignore
# ==================================

# Environment files with sensitive data
.env
.env.local
.env.production

# Security credentials and keys
INITIAL_ADMIN_CREDENTIALS.txt
*.key
*.pem
*.crt
security_key.key

# Database files
*.db
*.sqlite
*.sqlite3

# Exception: Allow historical data for deployment
!camp_power_up.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
.venv/
venv/
ENV/
env/

# Database files
*.db
*.sqlite
*.sqlite3

# Camp Data - NEVER commit sensitive information
data/*.csv
data/*.xlsx
data/*.xls
*.csv
camp_power_up.db

# Exception: Allow specific historical CSV for deployment
!data/Camp_Power_Up_past_forms\ -\ Sheet1.csv
camper_data.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variables
.env
