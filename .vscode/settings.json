{
  // ============================================================================
  // CampPowerUp VS Code Settings (JetBrains-style Configuration)
  // ============================================================================

  // Editor Settings (JetBrains-style)
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono, Menlo, Monaco, 'Courier New', monospace",
  "editor.lineHeight": 1.6,
  "editor.suggestSelection": "first",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "editor.rulers": [88, 120],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.renderWhitespace": "boundary",
  "editor.inlineSuggest.enabled": true,

  // File Explorer (JetBrains Project View style)
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.sortOrder": "type",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.py": "${capture}.pyc, ${capture}.pyo, __pycache__",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.ts": "${capture}.js, ${capture}.d.ts.map, ${capture}.d.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
    ".env": ".env.*",
    "docker-compose.yml": "docker-compose.*.yml, Dockerfile*",
    "README.md": "*.md"
  },

  // Python Settings (APCV 360, CYBV 302)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.languageServer": "Pylance",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.linting.flake8Enabled": true,
  "python.linting.mypyEnabled": true,
  "python.linting.banditEnabled": true,
  "python.linting.lintOnSave": true,
  "python.formatting.provider": "black",
  "python.formatting.blackArgs": ["--line-length=88"],
  "python.sortImports.args": ["--profile=black"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests",
    "-v",
    "--cov=src",
    "--cov-report=term",
    "--cov-report=html"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": true,

  // Git Settings (GitHub integration)
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.suggestSmartCommit": true,
  "git.postCommitCommand": "none",
  "git.enableCommitSigning": false,
  "git.showPushSuccessNotification": true,
  "git.pruneOnFetch": true,
  "git.pullBeforeCheckout": true,
  "git.fetchOnPull": true,
  "git.rebaseWhenSync": false,

  // GitHub Copilot
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true,
    "python": true
  },
  "github.copilot.editor.enableAutoCompletions": true,

  // Files Settings
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/*.db": false,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.coverage": true,
    "**/htmlcov": true,
    "**/.venv": false,
    "**/node_modules": true,
    "**/.git": false
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml",
    ".env*": "dotenv",
    "*.md": "markdown",
    "Dockerfile*": "dockerfile",
    ".pylintrc": "ini",
    "*.ini": "ini"
  },

  // Terminal Settings (JetBrains Terminal style)
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "JetBrains Mono, Menlo, Monaco",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}"
  },

  // Search Settings
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/htmlcov": true,
    "**/*.db": true,
    "**/*.log": true
  },
  "search.useIgnoreFiles": true,
  "search.showLineNumbers": true,

  // Workbench Settings (JetBrains-style UI)
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vs-seti",
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.tabCloseButton": "right",
  "workbench.editor.tabSizing": "shrink",
  "workbench.startupEditor": "welcomePage",
  "workbench.tree.indent": 20,
  "workbench.list.smoothScrolling": true,
  "workbench.sideBar.location": "left",

  // Breadcrumbs (JetBrains Navigation Bar style)
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",

  // Testing
  "testing.automaticallyOpenPeekView": "never",
  "testing.openTesting": "neverOpen",

  // Formatting
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // IntelliSense
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",

  // Security (CYBV 301)
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",

  // Extensions
  "extensions.ignoreRecommendations": false,

  // Notebook
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },

  // Todo Tree (Task tracking like JetBrains TODO view)
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "NOTE",
    "HACK",
    "XXX",
    "BUG",
    "SECURITY",
    "CYBV301",
    "APCV360",
    "CYBV302"
  ],
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text",
    "foreground": "#FFFFFF",
    "background": "#FF6B6B",
    "opacity": 50,
    "iconColour": "#FF6B6B"
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "iconColour": "#66BB6A"
    },
    "FIXME": {
      "icon": "bug",
      "iconColour": "#EF5350"
    },
    "NOTE": {
      "icon": "note",
      "iconColour": "#42A5F5"
    },
    "SECURITY": {
      "icon": "shield",
      "iconColour": "#FF9800"
    },
    "CYBV301": {
      "icon": "shield",
      "iconColour": "#9C27B0"
    },
    "APCV360": {
      "icon": "database",
      "iconColour": "#00BCD4"
    },
    "CYBV302": {
      "icon": "tools",
      "iconColour": "#4CAF50"
    }
  },

  // Error Lens (Inline errors like JetBrains)
  "errorLens.enabledDiagnosticLevels": ["error", "warning", "info"],
  "errorLens.fontSize": "12",

  // Project specific
  "campPowerUp.registrationUrl": "https://camppowerup-registration.up.railway.app",
  "campPowerUp.stagingUrl": "https://camppowerup-staging.up.railway.app"
}
