# Quick Production Test Environment
# Copy this to .env for local testing

FLASK_ENV=production
SECRET_KEY=test-secret-key-for-local-production-test
DEBUG=False

# Keep SQLite for quick local test
DATABASE_URL=sqlite:///camp_power_up.db
REGISTRATION_DATABASE_URL=sqlite:///registration_form/registration_submissions.db

# Server settings
PORT=5002
HOST=0.0.0.0

# Email (optional for testing)
MAIL_USERNAME=test@example.com
MAIL_PASSWORD=test-password

# Camp info
CAMP_NAME=Camp Power Up
CAMP_YEAR=2025
ADMIN_EMAIL=admin@camppowerup.com